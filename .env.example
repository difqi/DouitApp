# Next.js App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gemini API (Otak AI - Multi-Key Failover)
GEMINI_API_KEY_1=your_first_gemini_api_key
GEMINI_API_KEY_2=your_second_gemini_api_key_optional
GEMINI_API_KEY_3=your_third_gemini_api_key_optional
# Legacy / Single fallback key:
GEMINI_API_KEY=your_gemini_api_key

# Resend Inbound Webhook (Pencatatan Email Otomatis)
RESEND_API_KEY=your_resend_api_key
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret

# Email Domain
NEXT_PUBLIC_INBOUND_EMAIL_DOMAIN=your_inbound_domain.resend.app

# Fonnte WhatsApp Gateway API (Multi-Bot Failover)
FONNTE_API_TOKEN_1=your_first_fonnte_token
FONNTE_API_TOKEN_2=your_second_fonnte_token_optional
# Legacy / Single fallback token:
FONNTE_API_TOKEN=your_fonnte_api_token_here

# Cron Job Security Key
CRON_SECRET=douit_secure_cron_key_2026
